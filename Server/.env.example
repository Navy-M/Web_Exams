PORT=5000
NODE_ENV=development

# Development prefers LOCAL_MONGO_URI. MONGO_URI is the production/fallback URI.
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/web_exams
MONGO_URI=
MONGO_TIMEOUT_MS=30000

# Replace this with a long, random value before starting the server.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://127.0.0.1:5174

# Optional: required only when running the seed scripts.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_FULL_NAME=Sample User
